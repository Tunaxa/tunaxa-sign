{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Dev-only convenience: forwards the shell environment to tasks. Do not rely on this in CI/prod.
  "envMode": "loose",
  // 15 packages run persistent dev tasks (5 apps + 10 package watchers); Turbo needs concurrency >= 16.
  "concurrency": "16",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:migrate:status": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
