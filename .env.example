# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
SIGNING_URL=http://localhost:5174
ADMIN_URL=http://localhost:5175

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://axa:axa_secret@localhost:5432/axa_sign?schema=public

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object Storage (MinIO / S3) ─────────────────────
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_BUCKET=axa-sign
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=change-me-session-secret

# ── Email (SMTP) ────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tunaxa.com

# ── Crypto ───────────────────────────────────────────
SIGNING_CERT_PATH=./certs/signing.pem
SIGNING_KEY_PATH=./certs/signing.key

# ── Webhooks ─────────────────────────────────────────
WEBHOOK_SECRET=change-me-webhook-secret

# ── Observability ────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
