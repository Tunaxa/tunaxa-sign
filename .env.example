# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
SIGNING_URL=http://localhost:5174
ADMIN_URL=http://localhost:5175
# Number of trusted reverse proxies; production behind Cloudflare -> nginx needs 2.
TRUST_PROXY_HOPS=1

# ── Database ─────────────────────────────────────────
# Host port for the compose postgres service. Change this if 5432 is already in use,
# and keep the port in DATABASE_URL in sync.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tunaxa:axa_secret@localhost:5432/axa_sign?schema=public

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object Storage (MinIO / S3) ─────────────────────
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_BUCKET=axa-sign
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=change-me-session-secret

# ── Demo Seed (local development only) ───────────────
# Used by `npm run db:seed`. Never use these values in production.
SEED_ADMIN_PASSWORD=DevAdmin123!
SEED_AGENT_PASSWORD=DevAgent123!
SEED_ALLOW_PRODUCTION=false

# ── Email (SMTP) ────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tunaxa.com

# ── Crypto ───────────────────────────────────────────
SIGNING_CERT_PATH=./certs/signing.pem
SIGNING_KEY_PATH=./certs/signing.key

# ── Webhooks ─────────────────────────────────────────
WEBHOOK_SECRET=change-me-webhook-secret

# ── Observability ────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
