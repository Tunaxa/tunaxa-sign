{
  "name": "axa-sign",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/with-env.mjs turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "node scripts/with-env.mjs turbo db:generate",
    "db:migrate": "node scripts/with-env.mjs turbo db:migrate",
    "db:migrate:deploy": "node scripts/with-env.mjs turbo db:migrate:deploy",
    "db:migrate:status": "node scripts/with-env.mjs turbo db:migrate:status",
    "db:seed": "node scripts/with-env.mjs turbo db:seed",
    "db:studio": "node scripts/with-env.mjs turbo db:studio",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.0",
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.41.1": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "msgpackr-extract@3.0.4": true
  }
}
